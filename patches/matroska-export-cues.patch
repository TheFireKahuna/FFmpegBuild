+/* Per stream whose track has a ContentEncodings element, in stream order:
+ * stream index, number of ContentEncoding elements, then the first one's
+ * ContentEncodingType, ContentEncodingScope as coded, ContentCompAlgo, the
+ * size of ContentCompSettings and its bytes, one value each. */
+static int matroska_export_track_coding(MatroskaDemuxContext *matroska, int stream_index,
+                                        const MatroskaTrack *track, uint64_t coded_scope)
+{
+    const MatroskaTrackEncoding *encoding = track->encodings.elem;
+    const EbmlBin *settings = &encoding->compression.settings;
+    unsigned at = matroska->nb_track_coding;
+    int ret;
+
+    if (settings->size > UINT_MAX - 6 - at)
+        return AVERROR(ENOMEM);
+    ret = av_reallocp_array(&matroska->track_coding, at + 6 + settings->size,
+                            sizeof(*matroska->track_coding));
+    if (ret < 0) {
+        matroska->nb_track_coding = 0;
+        return ret;
+    }
+    matroska->track_coding[at++] = stream_index;
+    matroska->track_coding[at++] = track->encodings.nb_elem;
+    matroska->track_coding[at++] = encoding->type;
+    matroska->track_coding[at++] = coded_scope;
+    matroska->track_coding[at++] = encoding->compression.algo;
+    matroska->track_coding[at++] = settings->size;
+    for (int i = 0; i < settings->size; i++)
+        matroska->track_coding[at++] = settings->data[i];
+    matroska->nb_track_coding = at;
+    return 0;
+}
