+/* Five values per CueTrackPositions whose track became a stream, in file
+ * order: stream index, CueTime in segment ticks, cluster position from the
+ * start of the file, CueRelativePosition and CueDuration (-1 where absent).
+ * Only a Cues element that parsed whole is exported. */
+static int matroska_export_cue_points(MatroskaDemuxContext *matroska)
+{
+    EbmlList *index_list = &matroska->index;
+    MatroskaIndex *index = index_list->elem;
+    size_t count = 0;
+    int64_t *record;
+
+    av_freep(&matroska->cue_points);
+    matroska->nb_cue_points = 0;
+    if (matroska->cues_parsing_deferred)
+        return 0;
+    for (int i = 0; i < index_list->nb_elem; i++)
+        count += index[i].pos.nb_elem;
+    if (!count)
+        return 0;
+    if (count > UINT_MAX / 5)
+        return AVERROR(ENOMEM);
+    record = av_malloc_array(count * 5, sizeof(*record));
+    if (!record)
+        return AVERROR(ENOMEM);
+    matroska->cue_points = record;
+    for (int i = 0; i < index_list->nb_elem; i++) {
+        MatroskaIndexPos *pos = index[i].pos.elem;
+        for (int j = 0; j < index[i].pos.nb_elem; j++) {
+            MatroskaTrack *track = matroska_find_track_by_num(matroska, pos[j].track);
+            if (!track || !track->stream)
+                continue;
+            record[0] = track->stream->index;
+            record[1] = index[i].time;
+            record[2] = pos[j].pos + matroska->segment_start;
+            record[3] = pos[j].relative_pos == UINT64_MAX ? -1 : pos[j].relative_pos;
+            record[4] = pos[j].duration     == UINT64_MAX ? -1 : pos[j].duration;
+            record += 5;
+            matroska->nb_cue_points += 5;
+        }
     }
+    return 0;
 }
 
