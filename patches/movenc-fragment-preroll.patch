+
+/* The fragment's audio pre-roll group: an sgpd of grouping type 'prol' with
+ * one entry, the packets a decoder decodes before a sample for full output
+ * (seek_preroll in packets of frame_size, rounded up), and an sbgp that puts
+ * every sample that is not a sync sample in it. A fragment of sync samples
+ * only gets neither box. */
+static int mov_write_prol_tags(AVIOContext *pb, MOVTrack *track)
+{
+    const AVCodecParameters *par = track->par;
+    int64_t roll;
+    int i, runs = 0, grouped = 0;
+
+    if (par->codec_type != AVMEDIA_TYPE_AUDIO || par->seek_preroll <= 0 || par->frame_size <= 0)
+        return 0;
+    for (i = 0; i < track->entry; i++) {
+        int sync = track->cluster[i].flags & MOV_SYNC_SAMPLE;
+        grouped |= !sync;
+        if (!i || !sync != !(track->cluster[i - 1].flags & MOV_SYNC_SAMPLE))
+            runs++;
+    }
+    if (!grouped)
+        return 0;
+    roll = FFMIN((par->seek_preroll + par->frame_size - 1) / par->frame_size, INT16_MAX);
 
+    avio_wb32(pb, 26); /* size */
+    ffio_wfourcc(pb, "sgpd");
+    avio_wb32(pb, 1 << 24); /* version 1, flags */
+    ffio_wfourcc(pb, "prol");
+    avio_wb32(pb, 2); /* default_length */
+    avio_wb32(pb, 1); /* entry_count */
+    avio_wb16(pb, roll); /* roll_distance */
+
+    avio_wb32(pb, 20 + 8 * runs); /* size */
+    ffio_wfourcc(pb, "sbgp");
+    avio_wb32(pb, 0); /* version 0, flags */
+    ffio_wfourcc(pb, "prol");
+    avio_wb32(pb, runs); /* entry_count */
+    for (i = 0; i < track->entry;) {
+        int sync = track->cluster[i].flags & MOV_SYNC_SAMPLE;
+        int count = 0;
+        while (i < track->entry && !(track->cluster[i].flags & MOV_SYNC_SAMPLE) == !sync) {
+            count++;
+            i++;
+        }
+        avio_wb32(pb, count); /* sample_count */
+        /* the first entry of this fragment's sgpd, or no group */
+        avio_wb32(pb, sync ? 0 : 0x10001); /* group_description_index */
+    }
+    return 0;
+}
+
 static int mov_write_traf_tag(AVIOContext *pb, MOVMuxContext *mov,
                               MOVTrack *track, int64_t moof_offset,
                               int moof_size)
@@ -5719,6 +5770,8 @@
     mov_write_tfhd_tag(pb, mov, track, moof_offset);
     if (mov->mode != MODE_ISM)
         mov_write_tfdt_tag(pb, track);
+    if (mov->flags & FF_MOV_FLAG_FRAG_PREROLL)
+        mov_write_prol_tags(pb, track);
     for (i = 1; i < track->entry; i++) {
         if (track->cluster[i].pos != track->cluster[i - 1].pos + track->cluster[i - 1].size) {
             mov_write_trun_tag(pb, mov, track, moof_size, start, i);
