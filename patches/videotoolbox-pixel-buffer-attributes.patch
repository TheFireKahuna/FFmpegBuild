@@ -327,6 +324,8 @@ static int do_config_output(AVFilterLink *link) API_AVAILABLE(macos(10.11), ios(
     FilterLink *l = ff_filter_link(link);
     FilterLink *il = ff_filter_link(link->src->inputs[0]);
     AVHWFramesContext *output_frames, *input_frames;
+    AVVTFramesContext *output_vt, *input_vt;
+    const AVPixFmtDescriptor *desc;
     AVFilterContext *ctx = link->src;
     YADIFVTContext *s = ctx->priv;
     YADIFContext *y = &s->yadif;
@@ -355,7 +354,22 @@ static int do_config_output(AVFilterLink *link) API_AVAILABLE(macos(10.11), ios(
     output_frames->sw_format = s->input_frames->sw_format;
     output_frames->width     = ctx->inputs[0]->w;
     output_frames->height    = ctx->inputs[0]->h;
-    ((AVVTFramesContext *)output_frames->hwctx)->color_range = ((AVVTFramesContext *)input_frames->hwctx)->color_range;
+    output_vt = output_frames->hwctx;
+    input_vt  = input_frames->hwctx;
+    output_vt->color_range = input_vt->color_range;
+    // The output pictures are made as the caller made the input pictures.
+    if (input_vt->pixel_buffer_attributes)
+        output_vt->pixel_buffer_attributes = CFRetain(input_vt->pixel_buffer_attributes);
+
+    desc = av_pix_fmt_desc_get(output_frames->sw_format);
+    for (int i = 0; i < desc->nb_components; i++) {
+        int channels;
+        if (plane_format(&desc->comp[i], &channels) == MTLPixelFormatInvalid) {
+            av_log(ctx, AV_LOG_ERROR, "Unsupported pixel format: %s\n", desc->name);
+            ret = AVERROR(ENOSYS);
+            goto exit;
+        }
+    }
 
     ret = ff_filter_init_hw_frames(ctx, link, 10);
     if (ret < 0)
diff --git a/libavutil/hwcontext_videotoolbox.c b/libavutil/hwcontext_videotoolbox.c
index 2764097..8e4ae28 100644
--- a/libavutil/hwcontext_videotoolbox.c
+++ b/libavutil/hwcontext_videotoolbox.c
@@ -195,11 +195,16 @@ static int vt_pool_alloc(AVHWFramesContext *ctx)
     uint32_t cv_pixfmt;
     CFMutableDictionaryRef attributes, iosurface_properties;
 
-    attributes = CFDictionaryCreateMutable(
-        NULL,
-        2,
-        &kCFTypeDictionaryKeyCallBacks,
-        &kCFTypeDictionaryValueCallBacks);
+    if (hw_ctx->pixel_buffer_attributes)
+        attributes = CFDictionaryCreateMutableCopy(NULL, 0, hw_ctx->pixel_buffer_attributes);
+    else
+        attributes = CFDictionaryCreateMutable(
+            NULL,
+            2,
+            &kCFTypeDictionaryKeyCallBacks,
+            &kCFTypeDictionaryValueCallBacks);
+    if (!attributes)
+        return AVERROR(ENOMEM);
 
     cv_pixfmt = vt_format_from_pixfmt(ctx->sw_format, hw_ctx->color_range);
     pixfmt = CFNumberCreate(NULL, kCFNumberSInt32Type, &cv_pixfmt);
@@ -209,13 +214,15 @@ static int vt_pool_alloc(AVHWFramesContext *ctx)
         pixfmt);
     CFRelease(pixfmt);
 
-    iosurface_properties = CFDictionaryCreateMutable(
-        NULL,
-        0,
-        &kCFTypeDictionaryKeyCallBacks,
-        &kCFTypeDictionaryValueCallBacks);
-    CFDictionarySetValue(attributes, kCVPixelBufferIOSurfacePropertiesKey, iosurface_properties);
-    CFRelease(iosurface_properties);
+    if (!CFDictionaryContainsKey(attributes, kCVPixelBufferIOSurfacePropertiesKey)) {
+        iosurface_properties = CFDictionaryCreateMutable(
+            NULL,
+            0,
+            &kCFTypeDictionaryKeyCallBacks,
+            &kCFTypeDictionaryValueCallBacks);
+        CFDictionarySetValue(attributes, kCVPixelBufferIOSurfacePropertiesKey, iosurface_properties);
+        CFRelease(iosurface_properties);
+    }
 
     w = CFNumberCreate(NULL, kCFNumberSInt32Type, &ctx->width);
     h = CFNumberCreate(NULL, kCFNumberSInt32Type, &ctx->height);
@@ -277,6 +284,10 @@ static void vt_frames_uninit(AVHWFramesContext *ctx)
         CVPixelBufferPoolRelease(fctx->pool);
         fctx->pool = NULL;
     }
+    if (fctx->p.pixel_buffer_attributes) {
+        CFRelease(fctx->p.pixel_buffer_attributes);
+        fctx->p.pixel_buffer_attributes = NULL;
+    }
 }
 
 static int vt_frames_init(AVHWFramesContext *ctx)
diff --git a/libavutil/hwcontext_videotoolbox.h b/libavutil/hwcontext_videotoolbox.h
