avcodec/h2645_sei: alternative transfer characteristics last one coded video sequence

The alternative transfer characteristics SEI (preferred_transfer_
characteristics, how HLG is signalled over a BT.2020 transfer, 3GPP TS
26.118) persists in decoding order to the end of the CLVS (H.265 D.3) / the
coded video sequence (H.264). The decoders never cleared it: once seen, it
overrode the transfer of every later picture, an SDR programme after an HLG
one included. And H.264 did not carry it between frame threads
(ff_h2645_sei_ctx_replace), so with frame threading only the pictures
decoded on the thread that parsed it took it.

Track whether the message arrived with the current picture. A new coded
video sequence without one ends it: HEVC at an IDR, a BLA or after an end
of sequence (the transfer goes back to the SPS's), H.264 at an IDR picture
(not its second field). Copy it between threads with the other persistent
SEI state.
--- a/libavcodec/h2645_sei.h
+++ b/libavcodec/h2645_sei.h
@@ -80,6 +80,9 @@
 typedef struct H2645SEIAlternativeTransfer {
     int present;
     int preferred_transfer_characteristics;
+    /* Set when the message arrives, cleared by the decoder once a picture has
+     * taken it: a new coded video sequence that starts without one ends it. */
+    int received;
 } H2645SEIAlternativeTransfer;
 
 typedef struct H2645SEIAmbientViewingEnvironment {
--- a/libavcodec/h2645_sei.c
+++ b/libavcodec/h2645_sei.c
@@ -381,6 +381,7 @@
         return AVERROR_INVALIDDATA;
 
     s->present = 1;
+    s->received = 1;
     s->preferred_transfer_characteristics = bytestream2_get_byteu(gb);
 
     return 0;
@@ -578,6 +579,9 @@
     dst->ambient_viewing_environment = src->ambient_viewing_environment;
     dst->mastering_display     = src->mastering_display;
     dst->content_light         = src->content_light;
+    /* Persistent to the end of the coded video sequence: every frame thread's
+     * pictures take it, not only the thread that parsed it. */
+    dst->alternative_transfer  = src->alternative_transfer;
 
     av_refstruct_replace(&dst->film_grain_characteristics,
                           src->film_grain_characteristics);
